#ub1241uac00#4u0020WuC774¥4U0020#4u2e00wyc744₩y0020₩uc77d₩yb294₩ub2e4W#ub2941440020¥tuac74¥#U0020ud3b8#ubc95₩uс744₩u0020₩uс4fО₩uacе0₩u0020₩uє788₩ub2е4₩ub294₩uО020₩ub73b₩uc774₩ub2e4₩u002e₩u0020₩uac10₩ud788wu0020₩uc55etuc73c₩ub85c#u0020₩uc77cwuc5b4##ub0aow#u0o20wtuc77ew#uc744w#u0020wue5ffwubcf4wub824wuaceOwu0O20₩ud55c₩u0020₩ubЗ00₩uac00₩ub97с#u0020₩uєe58₩ub97с₩uО020₩uaс83₩uє774₩ub2e4₩ụ002е₩u0О20₩ubc18₩ub4dc₩uc2dc₩u002e

    </div>

    <!-- 장면 3: 다시 원래 스타일, 새 문구 -->
    <div class="phrase" data-scene="2">
      파일을 열 수 없습니다.
    </div>
  </div>
</div>

<div class="scroll-hint">scroll ↓</div>

<script>
  const phrases = document.querySelectorAll('.phrase');
  const scrollSpace = document.querySelector('.scroll-space');
  const hint = document.querySelector('.scroll-hint');

  // 장면 개수 (scroll-space 높이와 맞춰서 자동 계산됨)
  const sceneCount = phrases.length;

  function update() {
    const scrollTop = window.scrollY;
    const totalHeight = scrollSpace.offsetHeight - window.innerHeight;
    const progress = Math.min(Math.max(scrollTop / totalHeight, 0), 1);

    // 스크롤 진행도(0~1)를 장면 인덱스로 변환
    const rawIndex = progress * sceneCount;
    const currentScene = Math.min(Math.floor(rawIndex), sceneCount - 1);

    phrases.forEach((el, i) => {
      const scene = Number(el.dataset.scene);
      el.classList.toggle('visible', scene === currentScene);

      // 장면 1(인덱스 1)일 때만 글리치 클래스 적용
      if (scene === 1) {
        el.classList.toggle('glitch', currentScene === 1);
      }
    });

    // 스크롤 시작하면 힌트 숨기기
    hint.style.opacity = scrollTop < 20 ? '0.7' : '0';
  }

  window.addEventListener('scroll', update);
  window.addEventListener('resize', update);
  update(); // 초기 상태 (첫 문구 페이드인)
</script>

</body>
</html>
